# Clarah asks Gemini first and falls back to the OpenAI-compatible backup if Gemini fails.
# Set at least one of the two keys.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-3.5-flash-lite, small and fast)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: visit recaps (recording and Clarah's voice use Gemini only)
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Sulafat

# Backup: an OpenAI-compatible API key (default provider: Pulpo, https://pulpo.baby)
OPENAI_API_KEY=
# Optional: another OpenAI-compatible endpoint (default https://pulpo.baby/v1)
# OPENAI_BASE_URL=https://pulpo.baby/v1
# Optional: model ID from GET /v1/models (default glm-5.3-flash)
# OPENAI_MODEL=glm-5.3-flash

# Optional: Epic SMART on FHIR sandbox. Without it, Clarah uses the demo patient.
# Register a non-production app at https://fhir.epic.com with redirect URIs
#   http://localhost:3000/callback and https://<your-domain>/callback
EPIC_CLIENT_ID=

# Optional: Fitbit Web API. Without it, Clarah uses demo wearable data.
# Register at https://dev.fitbit.com/apps with callback URL
#   http://localhost:3000/api/auth/fitbit/callback
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Optional: shown on the urgent screen's "Call my care team" button
CARE_TEAM_PHONE=

# Optional: public URL when deployed (used to build OAuth redirect URIs)
# APP_URL=https://your-app.example.com
